<?xml version="1.0" encoding="utf-8"?>
<!-- Playground : écrivez ici le layout des exemples du cours -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".PlaygroundActivity"
    >

    <TextView
        android:id="@+id/txtBienvenue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenue au cybercafe Al Amal"
        android:textSize="30sp"
        android:textColor="#1B7A3E" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/s01_horaires"
        android:textSize="24sp"
      />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/s01_tarif"
        android:textSize="24sp"
        android:textStyle="bold"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/s01_contact"
        android:textSize="20sp"
        android:autoLink="web|phone|email" />


</LinearLayout>
